# Copy required values into .env, or run setup. Never commit real credentials.
TONGJI_USERNAME=""
TONGJI_PASSWORD=""
ASR_ENGINE="fun-asr"
# Alibaba Cloud Model Studio, Beijing region
DASHSCOPE_API_KEY=""
# Optional: persistent private cache; default is <skill_root>/state/fun-asr
# FUN_ASR_STATE_DIR="/absolute/path/to/private/asr-state"
# Legacy opt-in only: ASR_ENGINE="bcut"

# Optional read-only balance checks: configure credentials in aliyun CLI, not here.
# Must belong to the same paying account as DASHSCOPE_API_KEY.
# ALIYUN_BILLING_PROFILE="tongji-billing"
# Cash-balance warning only; unset disables warnings. No automatic task blocking.
# ALIYUN_LOW_BALANCE_THRESHOLD="10.00"
# ALIYUN_BALANCE_CURRENCY="CNY"
